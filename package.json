{
    "name": "@lokalise/fastify-extras",
    "version": "34.0.0",
    "description": "Opinionated set of fastify plugins, commonly used in Lokalise",
    "author": {
        "name": "Lokalise",
        "url": "https://lokalise.com/"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git://github.com/lokalise/fastify-extras.git"
    },
    "keywords": ["fastify", "bugsnag", "request-context", "request-id", "split-io"],
    "homepage": "https://github.com/lokalise/fastify-extras",
    "files": ["dist/**", "LICENSE", "README.md"],
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist && tsc --project tsconfig.build.json",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "test:ci": "pnpm run lint && pnpm run test:coverage",
        "lint": "biome check . && tsc",
        "lint:fix": "biome check --write",
        "docker:start": "docker compose -f docker-compose.yml up --build -d redis && docker compose -f docker-compose.yml up --build -d wait_for_redis",
        "docker:stop": "docker compose -f docker-compose.yml down",
        "changeset": "changeset",
        "ci:publish": "pnpm run build && changeset publish"
    },
    "dependencies": {
        "@amplitude/analytics-node": "^1.5.7",
        "@bugsnag/js": "^8.4.0",
        "@bugsnag/node": "^8.4.0",
        "@fastify/error": "^4.2.0",
        "@lokalise/error-utils": "^4.0.0",
        "@prometheus-io/client": "^0.16.1",
        "@scalar/fastify-api-reference": "^1.66.1",
        "@splitsoftware/splitio": "^11.6.0",
        "@supercharge/promise-pool": "^3.2.0",
        "fastify-metrics": "^14.0.0",
        "fastify-plugin": "^6.0.0",
        "toad-cache": "^3.7.4"
    },
    "peerDependencies": {
        "@fastify/jwt": ">=9.1.0",
        "@fastify/swagger": ">=9.5.1",
        "@lokalise/api-contracts": ">=5.0.0",
        "@lokalise/background-jobs-common": ">=12.0.0",
        "@lokalise/errors": ">=2.0.0",
        "@lokalise/node-core": ">=14.0.0",
        "@opentelemetry/api": ">=1.9.0",
        "bullmq": "^5.19.0 || ^6.0.0",
        "dd-trace": ">=5.0.0",
        "fastify": "^5.10.0",
        "fastify-type-provider-zod": ">=6.0.0",
        "ioredis": "^5.7.0 || ^6.0.0",
        "pino": ">=9.9.0",
        "zod": ">=4.1.5"
    },
    "devDependencies": {
        "@amplitude/analytics-types": "^2.10.0",
        "@biomejs/biome": "^1.9.4",
        "@changesets/cli": "^3.0.1",
        "@fastify/sse": "^0.6.0",
        "@fastify/swagger": "^9.8.1",
        "@lokalise/backend-http-client": "12.0.0",
        "@lokalise/background-jobs-common": "^15.2.0",
        "@lokalise/biome-config": "^2.0.0",
        "@lokalise/errors": "^2.0.0",
        "@lokalise/node-core": "^14.4.2",
        "@lokalise/tsconfig": "^3.0.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/context-async-hooks": "^2.10.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@types/node": "^24.7.0",
        "@vitest/coverage-v8": "^4.1.9",
        "bullmq": "^6.2.0",
        "dd-trace": "^6.0.0",
        "fastify": "^5.10.0",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "parse-sse": "^0.1.0",
        "pino": "^10.0.0",
        "pino-pretty": "^13.1.1",
        "rimraf": "^6.0.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9",
        "zod": "^4.1.12"
    },
    "engines": {
        "node": ">=24.3.0"
    },
    "packageManager": "pnpm@11.9.0"
}
